msgstr "Volgende fout ontvangen met wachtwoordsleutelketting: %1"

#: ui/main.qml:77
#, kde-format
msgctxt "@option:check Enable RDP server"
msgid "Enable RDP server"
msgstr "RDP-server inschakelen"

#: ui/main.qml:119
#, kde-format
msgctxt "@info:status"
msgid "Systemd not found. krdpserver will require manual activation."
msgstr "Systemd niet gevonden. krdpserver zal handmatige activatie vereisen."

