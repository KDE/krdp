#: ui/main.qml:143 ui/main_phone.qml:101
#, kde-format
msgid ""
"Users listed below can log into this device remotely using apps that support "
"the “RDP” protocol."
msgstr ""
"De hieronder vermelde gebruikers kunnen op afstand zich op dit apparaat "
"aanmelden met behulp van toepassen die het \"RDP\"-protocol ondersteunen."

#: ui/main.qml:153
#, kde-format
