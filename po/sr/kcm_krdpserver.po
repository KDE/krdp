msgid "Enable RDP server"
msgstr "Укључи РДП сервер"

#: ui/main.qml:119
#, kde-format
msgctxt "@info:status"
msgid "Systemd not found. krdpserver will require manual activation."
msgstr "Системд није нађен. krdpserver ће морати ручно да се покреће."

