msgstr "Ricevuto il seguente errore con il portachiavi delle password: %1"

#: ui/main.qml:77
#, kde-format
msgctxt "@option:check Enable RDP server"
msgid "Enable RDP server"
msgstr "Abilita il server RDP"

#: ui/main.qml:119
#, kde-format
msgctxt "@info:status"
msgid "Systemd not found. krdpserver will require manual activation."
msgstr "Systemd non trovato. krdpserver richiederà l'attivazione manuale."

#: ui/main.qml:128
#, kde-kuit-format
