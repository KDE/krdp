#: ui/main.qml:143 ui/main_phone.qml:101
#, kde-format
msgid ""
"Users listed below can log into this device remotely using apps that support "
"the “RDP” protocol."
msgstr ""
"Gli utenti elencati di seguito possono accedere a questo dispositivo da "
"remoto utilizzando applicazioni che supportano il protocollo «RDP»."

#: ui/main.qml:153
#, kde-format
msgctxt "@info:usagetip"
