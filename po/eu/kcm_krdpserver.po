#. i18n: ectx: label, entry (listenPort), group (General)
#: krdpserversettings.kcfg:14
#, kde-format
msgid "The port the server listens on"
msgstr "Zerbitzariak entzuten duen ataka"

#. i18n: ectx: label, entry (autogenerateCertificates), group (General)
#: krdpserversettings.kcfg:18
#, kde-format
msgid "Are certificates autogenerated during server start"
msgstr "Zerbitzaria abiatzean ziurtagiriak automatikoki sortzen dira?"

#. i18n: ectx: label, entry (certificate), group (General)
#: krdpserversettings.kcfg:22
#, kde-format
msgid "The certificate to use for TLS connections"
msgstr "TLS konexioetarako erabili behar den ziurtagiria"

#. i18n: ectx: label, entry (certificateKey), group (General)
#: krdpserversettings.kcfg:25
#, kde-format
msgid "The key that matches the TLS certificate"
msgstr "TLS ziurtagiriarekin bat datorren gakoa"

#. i18n: ectx: label, entry (quality), group (General)
#: krdpserversettings.kcfg:28
#, kde-format
msgid ""
"The quality of the video stream. The maximum quality when AdaptiveQuality is "
"enabled."
msgstr ""

#. i18n: ectx: label, entry (adaptiveQuality), group (General)
#: krdpserversettings.kcfg:32
#, kde-format
msgid ""
"Adjust the video quality at runtime based on the client's network "
"conditions, up to Quality."
msgstr ""

#. i18n: ectx: label, entry (Users), group (General)
#: krdpserversettings.kcfg:36
#, kde-format
msgid "Users allowed to login, passwords are stored in KWallet"
msgstr ""
"Saio-hasteko baimendutako erabiltzaileak, pasahitzak «KWallet»en gordetzen "
"dira"

#. i18n: ectx: label, entry (systemUserEnabled), group (General)
#: krdpserversettings.kcfg:39
#, kde-format
msgid "Whether the current user can log in via PAM"
msgstr "Uneko erabiltzaileak PAM bidez saioa hasi dezakeen ala ez"

#. i18n: ectx: label, entry (autostart), group (General)
#: krdpserversettings.kcfg:43
#, kde-format
msgid "Autostart the server on login"
msgstr "Abiarazi zerbitzaria automatikoki saioa hasten denean"

#. i18n: ectx: label, entry (lockOnDisconnect), group (General)
#: krdpserversettings.kcfg:47
#, kde-format
msgid ""
"Lock the session when the last client disconnects and unlock it on connect"
msgstr ""
"Azken bezeroa deskonektatzen denean saioa giltzatu eta konektatzean "
"giltzapetik askatu"

#: ui/CertError.qml:14
#, kde-format
msgctxt "@info:status"
msgid "Generating certificates automatically has failed!"
msgstr "Ziurtagiriak automatikoki sortzea huts egin du!"

