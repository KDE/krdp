msgid "Enable RDP server"
msgstr "مكن خادم سطح المكتب البعيد"

#: ui/main.qml:119
#, kde-format
msgctxt "@info:status"
msgid "Systemd not found. krdpserver will require manual activation."
msgstr "لم يُعثر على Systemd. سيتطلب krdpserver التفعيل اليدوي."

