#. i18n: ectx: label, entry (listenPort), group (General)
#: krdpserversettings.kcfg:14
#, kde-format
msgid "The port the server listens on"
msgstr "المنفذ الذي يستمع الخادم له"

#. i18n: ectx: label, entry (autogenerateCertificates), group (General)
#: krdpserversettings.kcfg:18
#, kde-format
msgid "Are certificates autogenerated during server start"
msgstr "هل ستنشئ الشهادات آليًّا أثناء بدء تشغيل الخادم؟"

#. i18n: ectx: label, entry (certificate), group (General)
#: krdpserversettings.kcfg:22
#, kde-format
msgid "The certificate to use for TLS connections"
msgstr "الشهادة المستخدمة لاتصالات TLS"

#. i18n: ectx: label, entry (certificateKey), group (General)
#: krdpserversettings.kcfg:25
#, kde-format
msgid "The key that matches the TLS certificate"
msgstr "المفتاح الذي يطابق شهادة TLS"

#. i18n: ectx: label, entry (quality), group (General)
#: krdpserversettings.kcfg:28
#, kde-format
msgid ""
"The quality of the video stream. The maximum quality when AdaptiveQuality is "
"enabled."
msgstr "جودة دفق الفيديو. الجودّة القصوى عند تمكين ميزة AdaptiveQuality."

#. i18n: ectx: label, entry (adaptiveQuality), group (General)
#: krdpserversettings.kcfg:32
#, kde-format
msgid ""
"Adjust the video quality at runtime based on the client's network "
"conditions, up to Quality."
msgstr ""
"اضبط جودة الفيديو أثناء التشغيل وفقًا لظروف شبكة العميل، بحد أقصى يبلغ "
"«الجودة»."

#. i18n: ectx: label, entry (Users), group (General)
#: krdpserversettings.kcfg:36
#, kde-format
msgid "Users allowed to login, passwords are stored in KWallet"
msgstr "يُسمح للمستخدمين بالولوج، وستخزن كلمات المرور في محفظةك"

#. i18n: ectx: label, entry (systemUserEnabled), group (General)
#: krdpserversettings.kcfg:39
#, kde-format
msgid "Whether the current user can log in via PAM"
msgstr "ما إذا كان المستخدم الحالي يمكنه الولوج باستخدام PAM"

#. i18n: ectx: label, entry (autostart), group (General)
#: krdpserversettings.kcfg:43
#, kde-format
msgid "Autostart the server on login"
msgstr "تشغيل الخادم آليًّا عند الولوج"

#. i18n: ectx: label, entry (exclusiveMode), group (General)
#: krdpserversettings.kcfg:47
#, kde-format
msgid ""
"Disable the host monitors and create virtual screens for exclusive session "
"use by a remote user"
msgstr ""
"تعطيل شاشات المضيف وإنشاء شاشات افتراضية للاستخدام الحصري في الجلسة من قِبل "
"مستخدم بعيد"

#: ui/CertError.qml:14
#, kde-format
msgctxt "@info:status"
msgid "Generating certificates automatically has failed!"
msgstr "لقد فشلت عملية إنشاء الشهادات آليًّا!"

#: ui/CertLoader.qml:19
#, kde-format
msgctxt "@title:window"
msgid "Select certificate key file"
msgstr "حدد ملف مفتاح الشهادة"

#: ui/CertLoader.qml:19
#, kde-format
msgctxt "@title:window"
msgid "Select certificate file"
msgstr "حدد ملف الشهادة"

#: ui/CodecError.qml:13
#, kde-format
msgctxt "@info:status"
msgid ""
"Remote desktop cannot be enabled because your system does not support H264 "
"video encoding. Please contact your distribution regarding how to enable it."
msgstr ""
"لا يمكن تمكين سطح المكتب البعيد لأن نظامك لا يتيح ترميز الفيديو H264. يرجى "
"الاتصال بتوزيعك لمعرفة كيفية تمكينه."

#: ui/DeleteUserModal.qml:14
#, kde-format
msgctxt "@title:window"
msgid "Discard user?"
msgstr "تجاهل مستخدم؟"

#: ui/DeleteUserModal.qml:15
#, kde-format
msgctxt "@info"
msgid "Are you sure you want to discard following user: %1?"
msgstr "هل أنت متأكد أنك تريد تجاهل المستخدم التالي: %1؟"

