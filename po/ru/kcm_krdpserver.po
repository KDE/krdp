#, kde-format
msgctxt "@label:button"
msgid "Save"
msgstr "Сохранить"

#: ui/EditUserModal.qml:78
#, kde-format
msgctxt "@label:textbox"
msgid "Username:"
msgstr "Имя пользователя:"

#: ui/EditUserModal.qml:88
#, kde-format
msgctxt "@info"
msgid "Username already exists!"
msgstr "Это имя пользователя уже существует!"

#: ui/EditUserModal.qml:94
#, kde-format
msgctxt "@label:textbox"
msgid "Password:"
msgstr "Пароль:"

#: ui/KeychainErrorDialog.qml:14
#, kde-format
msgctxt "@title:window"
msgid "Keychain error"
msgstr "Ошибка связки ключей"

#: ui/KeychainErrorDialog.qml:15
#, kde-format
msgctxt "@info"
msgid "Received following error with password keychain: %1"
msgstr "Получена следующая ошибка парольной связки ключей: %1"

#: ui/main.qml:77
#, kde-format
msgctxt "@option:check Enable RDP server"
msgid "Enable RDP server"
msgstr "Включить RDP-сервер"

#: ui/main.qml:119
#, kde-format
msgctxt "@info:status"
msgid "Systemd not found. krdpserver will require manual activation."
msgstr ""
"Система инициализации Systemd не найдена. Для запуска krdpserver потребуется "
"запускать его вручную."

#: ui/main.qml:128
#, kde-kuit-format
msgctxt "@info:status"
msgid "Error message from the RDP server:<nl/>%1"
msgstr "Сообщение RDP-сервера об ошибке:<nl/>%1"

#: ui/main.qml:143 ui/main_phone.qml:101
#, kde-format
msgid ""
"Users listed below can log into this device remotely using apps that support "
"the “RDP” protocol."
msgstr ""
"Перечисленные ниже пользователи могут удалённо входить в систему на этом "
"устройстве с помощью приложений, поддерживающих протокол удалённого рабочего "
"стола «RDP»."

#: ui/main.qml:153
#, kde-format
msgctxt "@info:usagetip"
msgid "Connect to this device at any of the following addresses:"
msgstr "К этому устройству можно подключиться по любому из следующих адресов:"

#: ui/main.qml:188 ui/main_phone.qml:158
#, kde-format
msgctxt "@action:button"
msgid "Copy Address to Clipboard"
msgstr "Скопировать адрес в буфер обмена"

#: ui/main.qml:233 ui/main_phone.qml:173
#, kde-format
msgctxt "@title:group"
msgid "Server Settings"
msgstr "Параметры сервера"

#: ui/main.qml:236
#, kde-format
msgctxt "part of a sentence: 'Start server [automatically on login]'"
msgid "Start server:"
msgstr "Запуск сервера:"

#: ui/main.qml:240
#, kde-format
msgctxt "part of a sentence: 'Start server automatically on login'"
msgid "Automatically on login"
msgstr "Автоматически при входе в систему"

