#: ui/RestartServerWarning.qml:13
#, kde-format
msgctxt "@info:status"
msgid ""
"Restart the server to apply changed settings. This may disconnect active "
"connections."
msgstr ""
"Перезапустить сервер для применения изменённых параметров. Это может "
"привести к разрыву активных соединений."

#: ui/RestartServerWarning.qml:17
#, kde-format
msgid "Restart Server"
msgstr "Перезапустить сервер"

