msgstr ""
"Redémarrez le serveur pour appliquer les modifications de configuration. "
"Cela peut couper les connexions actives."

#: ui/RestartServerWarning.qml:17
#, kde-format
msgid "Restart Server"
msgstr "Redémarrer le serveur"

