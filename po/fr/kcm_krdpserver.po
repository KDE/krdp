#: ui/main.qml:285
#, kde-format
msgctxt "@info:usagetip"
msgid "Displays will be locked, and the remote user will see a virtual screen."
msgstr ""
"Les écrans seront verrouillés et l'utilisateur distant verra un écran "
"virtuel."

#: ui/main.qml:288
#, kde-format
msgid "Enable exclusive mode"
msgstr "Activer le mode exclusif"

#: ui/main.qml:302
