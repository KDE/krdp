#. i18n: ectx: label, entry (listenPort), group (General)
#: krdpserversettings.kcfg:14
#, kde-format
msgid "The port the server listens on"
msgstr "Le port sur lequel le serveur écoute"

#. i18n: ectx: label, entry (autogenerateCertificates), group (General)
#: krdpserversettings.kcfg:18
#, kde-format
msgid "Are certificates autogenerated during server start"
msgstr ""
"Les certificats sont-ils générés automatiquement au démarrage du serveur"

#. i18n: ectx: label, entry (certificate), group (General)
#: krdpserversettings.kcfg:22
#, kde-format
msgid "The certificate to use for TLS connections"
msgstr "Le certificat à utiliser pour les connexions « TLS »"

#. i18n: ectx: label, entry (certificateKey), group (General)
#: krdpserversettings.kcfg:25
#, kde-format
msgid "The key that matches the TLS certificate"
msgstr "La clé qui correspond au certificat « TLS »"

#. i18n: ectx: label, entry (quality), group (General)
#: krdpserversettings.kcfg:28
#, kde-format
msgid ""
"The quality of the video stream. The maximum quality when AdaptiveQuality is "
"enabled."
msgstr ""
"La qualité du flux vidéo. La qualité est maximale lorsque l'option "
"« AdaptiveQuality » est activée."

#. i18n: ectx: label, entry (adaptiveQuality), group (General)
#: krdpserversettings.kcfg:32
#, kde-format
msgid ""
"Adjust the video quality at runtime based on the client's network "
"conditions, up to Quality."
msgstr ""
"Ajustez la qualité vidéo au moment de l'exécution en fonction des conditions "
"du réseau du client, jusqu'au niveau de qualité souhaité."

#. i18n: ectx: label, entry (Users), group (General)
#: krdpserversettings.kcfg:36
#, kde-format
msgid "Users allowed to login, passwords are stored in KWallet"
msgstr ""
"Utilisateurs autorisés à se connecter. Les mots de passe sont enregistrés "
"dans KWallet."

#. i18n: ectx: label, entry (systemUserEnabled), group (General)
#: krdpserversettings.kcfg:39
#, kde-format
msgid "Whether the current user can log in via PAM"
msgstr "Définit si l'utilisateur actuel peut ou non se connecter grâce à PAM"

#. i18n: ectx: label, entry (autostart), group (General)
#: krdpserversettings.kcfg:43
#, kde-format
msgid "Autostart the server on login"
msgstr "Démarrer automatiquement le serveur à la connexion"

#. i18n: ectx: label, entry (exclusiveMode), group (General)
#: krdpserversettings.kcfg:47
#, kde-format
msgid ""
"Disable the host monitors and create virtual screens for exclusive session "
"use by a remote user"
msgstr ""
"Désactivez les écrans hôtes et créez des écrans virtuels pour une "
"utilisation d'une session exclusive par un utilisateur distant"

#: ui/CertError.qml:14
#, kde-format
msgctxt "@info:status"
msgid "Generating certificates automatically has failed!"
msgstr "La génération automatique des certificats a échoué !"

#: ui/CertLoader.qml:19
#, kde-format
msgctxt "@title:window"
msgid "Select certificate key file"
msgstr "Sélectionner un fichier de clé de certificat"

#: ui/CertLoader.qml:19
#, kde-format
msgctxt "@title:window"
msgid "Select certificate file"
msgstr "Sélectionner un fichier de certificat"

#: ui/CodecError.qml:13
#, kde-format
msgctxt "@info:status"
msgid ""
"Remote desktop cannot be enabled because your system does not support H264 "
"video encoding. Please contact your distribution regarding how to enable it."
msgstr ""
"Il est impossible d'activer le bureau à distance car votre système ne prend "
"pas en charge l'encodage vidéo « H264 ». Veuillez contacter votre "
"distribution pour savoir comment l'activer."

#: ui/DeleteUserModal.qml:14
#, kde-format
msgctxt "@title:window"
msgid "Discard user?"
msgstr "Abandonner l'utilisateur ?"

#: ui/DeleteUserModal.qml:15
#, kde-format
msgctxt "@info"
msgid "Are you sure you want to discard following user: %1?"
msgstr "Voulez-vous vraiment supprimer l'utilisateur suivant : %1 ?"

#: ui/EditUserModal.qml:20
#, kde-format
msgctxt "@title:window"
msgid "Add new user"
msgstr "Ajouter un nouvel utilisateur"

#: ui/EditUserModal.qml:20
#, kde-format
msgctxt "@title:window"
msgid "Modify user"
msgstr "Modifier un utilisateur"

#: ui/EditUserModal.qml:67
#, kde-format
msgctxt "@label:button"
msgid "Save"
msgstr "Enregistrer"

#: ui/EditUserModal.qml:78
#, kde-format
msgctxt "@label:textbox"
msgid "Username:"
msgstr "Nom d'utilisateur :"

#: ui/EditUserModal.qml:88
#, kde-format
msgctxt "@info"
msgid "Username already exists!"
msgstr "Ce nom d'utilisateur existe déjà !"

#: ui/EditUserModal.qml:94
#, kde-format
msgctxt "@label:textbox"
msgid "Password:"
msgstr "Mot de passe :"

#: ui/KeychainErrorDialog.qml:14
#, kde-format
msgctxt "@title:window"
msgid "Keychain error"
msgstr "Erreur de trousseau"

#: ui/KeychainErrorDialog.qml:15
#, kde-format
msgctxt "@info"
msgid "Received following error with password keychain: %1"
msgstr "Erreur suivante reçue avec le trousseau de mots de passe : %1"

#: ui/main.qml:77
#, kde-format
msgctxt "@option:check Enable RDP server"
msgid "Enable RDP server"
msgstr "Activer le serveur « RDP »"

#: ui/main.qml:119
#, kde-format
msgctxt "@info:status"
msgid "Systemd not found. krdpserver will require manual activation."
msgstr ""
"Impossible de trouver le module « systemd ». Le module « krdpserver » "
"nécessitera une activation manuelle."

#: ui/main.qml:128
#, kde-kuit-format
msgctxt "@info:status"
msgid "Error message from the RDP server:<nl/>%1"
msgstr "Message d'erreur du serveur « RDP » :<nl/>%1"

#: ui/main.qml:143 ui/main_phone.qml:101
#, kde-format
msgid ""
"Users listed below can log into this device remotely using apps that support "
"the “RDP” protocol."
msgstr ""
"Les utilisateurs listés ci-dessous peuvent se connecter à ce périphérique en "
"utilisant ce périphérique à distance à l'aide d'applications prenant en "
"charge le protocole de bureau à distance « RDP »."

#: ui/main.qml:153
#, kde-format
msgctxt "@info:usagetip"
msgid "Connect to this device at any of the following addresses:"
msgstr "Connectez-vous à ce périphérique à l'une des adresses suivantes :"

#: ui/main.qml:188 ui/main_phone.qml:158
#, kde-format
msgctxt "@action:button"
msgid "Copy Address to Clipboard"
msgstr "Copier l'adresse dans le presse-papier"

